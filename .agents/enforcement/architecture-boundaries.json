{
  "rules": [
    {
      "id": "page-ui-cannot-bypass-facade",
      "severity": "block",
      "mode": "direct",
      "sourcePatterns": [
        "^pages/[^/]+/(?!.*(?:\\.test|\\.mock)\\.)[^/]+\\.tsx$",
        "^pages/[^/]+/components/(?!.*(?:\\.test|\\.mock)\\.).+\\.tsx$"
      ],
      "targetPatterns": [
        "^(?:shared/)?services/",
        "^services/",
        "^lib/",
        "^pages/[^/]+/(?:hooks|states|services)/"
      ],
      "targetSpecifiers": [
        "^@nino/lib/(?:services|api)/"
      ],
      "message": "Pages and domain components must consume integration through their feature facade."
    },
    {
      "id": "shared-cannot-import-page-domain",
      "severity": "block",
      "mode": "transitive",
      "sourceDirectories": ["shared"],
      "targetDirectories": ["pages"],
      "message": "Shared code must not depend on Page-domain internals."
    },
    {
      "id": "layout-cannot-import-page-domain",
      "severity": "block",
      "mode": "transitive",
      "sourceDirectories": ["layouts"],
      "targetDirectories": ["pages"],
      "message": "Layouts own persistent shell and must not select or implement a Page feature."
    },
    {
      "id": "page-domain-cannot-import-another-page-domain",
      "severity": "block",
      "mode": "direct",
      "sourceDirectories": ["pages"],
      "disallowDifferentPageDomain": true,
      "message": "One Page domain must not import another Page domain's internals."
    }
  ]
}
