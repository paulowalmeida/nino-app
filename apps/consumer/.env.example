VITE_BASE_URL=/api
# API usada pelo proxy do Vite; em produção o build usa a origem absoluta
# definida em vercel.json para manter OAuth e sessão no mesmo host.
VITE_API_PROXY_TARGET=https://api-dev.nino.delivery

# Client ID OAuth do Google (Web application), do Google Cloud Console.
# Sem ele o botão "Continuar com Google" simplesmente não aparece na tela.
VITE_GOOGLE_CLIENT_ID=""
