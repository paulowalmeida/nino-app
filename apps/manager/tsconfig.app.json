{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@ds/*": ["../../packages/ds/src/*"],
      "@adapters/*": ["src/adapters/*"],
      "@assets/*": ["src/assets/*"],
      "@atoms/*": ["src/UI/atoms/*"],
      "@constants/*": ["src/constants/*"],
      "@custom_types/*": ["src/types/*"],
      "@guards/*": ["src/guards/*"],
      "@hooks/*": ["src/hooks/*"],
      "@lib/*": ["src/lib/*"],
      "@loaders/*": ["src/loaders/*"],
      "@molecules/*": ["src/UI/molecules/*"],
      "@organisms/*": ["src/UI/organisms/*"],
      "@pages/*": ["src/UI/pages/*"],
      "@providers/*": ["src/providers/*"],
      "@router/*": ["src/router/*"],
      "@services/*": ["src/services/*"],
      "@skeletons/*": ["src/skeletons/*"],
      "@states/*": ["src/states/*"],
      "@styles/*": ["src/styles/*"],
      "@templates/*": ["src/UI/templates/*"],
      "@utils/*": ["src/utils/*"]
    }
  },
  "include": ["src"]
}
